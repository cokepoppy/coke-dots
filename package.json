{
  "name": "coke-dots",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"tsx watch src/server/index.ts\" \"vite --host 127.0.0.1\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "test": "node --import tsx --test tests/*.test.ts",
    "start": "tsx src/server/index.ts",
    "build:server": "esbuild src/server/index.ts --bundle --platform=node --format=esm --packages=external --outfile=server-dist/index.js",
    "build:electron": "esbuild electron/main.ts --bundle --platform=node --format=cjs --external:electron --outfile=electron-dist/main.cjs",
    "dev:desktop": "concurrently -k \"npm run dev:web\" \"npm run build:electron && wait-on http://127.0.0.1:5173 && DOTS_DEV_URL=http://127.0.0.1:5173 electron electron-dist/main.cjs\"",
    "desktop": "npm run build && npm run build:server && npm run build:electron && electron electron-dist/main.cjs"
  },
  "dependencies": {
    "@napi-rs/keyring": "^2.1.0",
    "google-auth-library": "^11.1.0",
    "playwright-core": "^1.56.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "electron": "39.8.10",
    "esbuild": "^0.28.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "wait-on": "^8.0.0"
  },
  "optionalDependencies": {
    "@deepseek-ai/dsh-sdk-client": "^0.1.0-rc.6",
    "@mariozechner/pi-coding-agent": "^0.73.1"
  }
}
