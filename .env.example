# Server reads these from its environment. Do not commit actual credentials.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:4317/auth/google/callback

# Optional path-mounted Mac demo. Keep the proxy token private and use a separate data directory.
DOTS_BASE_PATH=
DOTS_PUBLIC_HOST=
DOTS_PUBLIC_ORIGIN=
DOTS_APP_URL=
DOTS_TRUSTED_PROXY_TOKEN=

DOTS_MODEL_BASE_URL=https://api.openai.com/v1
DOTS_MODEL=your-chat-completions-model
# Optional bootstrap credential for the original local workspace only.
DOTS_MODEL_API_KEY=
DOTS_DATA_DIR=./data

# Optional agent backends. Claude Code may also be discovered in the sibling coke-codex-app vendor directory.
DOTS_CLAUDE_BIN=
DOTS_PI_ENABLED=0
DOTS_DSH_BIN=
DOTS_DSH_READ_ONLY_CONFIG=
