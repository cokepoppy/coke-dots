# Server reads these from its environment. Do not commit actual credentials.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:4317/auth/google/callback

# Optional Slack OAuth v2 app. Use the public HTTPS callback in production.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://127.0.0.1:4317/auth/slack/callback
# Slack Events API signing secret. Keep server-side; production request URL ends in /api/slack/events.
SLACK_SIGNING_SECRET=

# Optional instance-wide bootstrap configuration; the profile uses the same settings for all tenants.
DOTS_MODEL_BASE_URL=https://api.openai.com/v1
DOTS_MODEL=your-chat-completions-model
DOTS_MODEL_API_KEY=
DOTS_DATA_DIR=./data

# Optional low-latency Qwen speech-to-speech calls. The voice key is shared by
# the running Coke Dots instance and is never sent to a browser or tenant.
DOTS_VOICE_PROVIDER=browser
DOTS_QWEN_API_KEY=
DOTS_QWEN_WORKSPACE_ID=
DOTS_QWEN_REGION=beijing

# Optional Agent kernels.
DOTS_PI_ENABLED=0
DOTS_DSH_BIN=
DOTS_DSH_READ_ONLY_CONFIG=
